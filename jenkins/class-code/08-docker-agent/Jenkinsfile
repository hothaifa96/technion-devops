// 08 - Docker agents: image per stage, dockerfile agent, docker pipeline DSL (build/inside/push)
pipeline {
    agent none

    environment {
        IMAGE = 'myuser/docker-agent-demo'
    }

    stages {
        stage('Python in a container') {
            agent { docker { image 'python:3.12-slim' } }
            steps {
                sh 'python --version && pip --version'
            }
        }

        stage('Node in a container') {
            agent { docker { image 'node:20-alpine'; args '-e npm_config_cache=/tmp/.npm' } }
            steps {
                sh 'node --version && npm --version'
            }
        }

        stage('Custom CI image from Dockerfile') {
            agent {
                dockerfile {
                    filename 'Dockerfile.ci'
                    dir 'jenkins/class-code/08-docker-agent'
                }
            }
            steps {
                sh 'jq --version && yq --version && helm version --short'
            }
        }

        stage('Docker pipeline DSL') {
            agent any
            steps {
                script {
                    def img = docker.build("${IMAGE}:${env.BUILD_NUMBER}", 'docker/class-code/01-dockerfile')
                    img.inside {
                        sh 'python -c "import flask; print(flask.__version__)"'
                    }
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                        img.push()
                        img.push('latest')
                    }
                }
            }
        }
    }
}
