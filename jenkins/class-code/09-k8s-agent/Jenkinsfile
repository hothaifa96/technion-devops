  containers:
  - name: busybox
    image: busybox:1.38.0
    command: ["sleep"]
    args: ["infinity"]
'''
        }
    } 
    stages{
        stage('AAAAAA'){
            steps{
                echo 'hello from the other side ...... '
                sh 'curl google.com'
                sh 'ping -c 4 8.8.8.8'
            }
        }
    }
}